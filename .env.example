# Copy this file to the project root as .env for Docker Compose.
# Also copy it to backend/.env and fontend/.env.local for those apps.
# Replace the placeholder passwords and keep PG_PASSWORD consistent with
# the password in DATABASE_URL.
PG_PASSWORD=change-me-postgres
TILE_PASSWORD=change-me-tiles

# FastAPI (backend/.env)
DATABASE_URL=postgresql://postgres:change-me-postgres@127.0.0.1:5432/webmap_db
PANORAMAS_DIR=data/panoramas

# Vite frontend (fontend/.env.local)
VITE_API_BASE=http://127.0.0.1:8000
VITE_TILE_BASE=http://127.0.0.1:7800
VITE_SATELLITE_URL=http://127.0.0.1:8080/tiles/satellite/{z}/{x}/{y}
